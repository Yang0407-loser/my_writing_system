# ############ LLM 配置（DeepSeek V4 Pro） ############
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
# Writer 正文生成不使用 Pro 推理模型，单独路由到 Flash。
WRITER_LLM_MODEL=deepseek-v4-flash

# ############ Embedding 模型配置 ############
# 可选: 'sentence_transformers' (本地加载 BGE-M3), 'openai', 'ollama'
EMBEDDING_PROVIDER=sentence_transformers
# 当使用 sentence_transformers 时，可以指定模型名称（默认 BAAI/bge-m3）
EMBEDDING_MODEL=BAAI/bge-m3
# 当使用 ollama 时（本地已有 Ollama），设为: EMBEDDING_PROVIDER=ollama, EMBEDDING_MODEL=bge-m3:latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ############ 世界状态管理 (v0.6.0) ############
ENABLE_WORLD_STATE=true
WORLD_STATE_VERIFY_MODE=both     # "rule" | "llm" | "both" — 事实校验模式

# ############ 日志（可选）############
# LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ############ Redis 配置 ############
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1

# ############ Canonical Foundation database ############
# Production authority is PostgreSQL. Tests override this with a dedicated
# temporary SQLite URL; never point migration tests at tasks.db.
CANONICAL_DATABASE_URL=postgresql+psycopg://writer:replace_me@postgres:5432/writer
CANONICAL_COMMIT_MODE=legacy       # legacy | canary | internal_required
CANONICAL_CANARY_TASK_IDS=
CANONICAL_CANARY_SUBSECTION_IDS=
POSTGRES_USER=writer
POSTGRES_PASSWORD=replace_with_a_secret
POSTGRES_DB=writer
# Dedicated integration database; the name must end in _test.
TEST_CANONICAL_DATABASE_URL=postgresql+psycopg://writer_test:replace_with_a_secret@localhost:5432/writer_test

# ############ RAG 可观测性 ############
RAG_TOP_K=5
RAG_TRACE_CANDIDATE_K=0         # 仅扩展粗召回日志；0 保持旧版查询规模
RAG_PHASE3_SHADOW=false         # true 仅记录新旧结果；Writer 始终使用旧结果
RAG_PHASE3_MAX_QUERIES=4
RAG_PHASE3_CANDIDATE_K=12
RAG_PHASE3_MIN_SCORE=0.35

# ############ 本地 Cross-Encoder 重排（默认关闭）############
# 关闭时 search_with_meta 与旧实现逐字节一致：粗召回规模、返回条目、trace 键全部不变。
# 这不是重开 Phase 3——它只对"单条 legacy query"的候选列表做本地重排序。
# 模型在本机跑，正文不出网，因此不触及禁止外发私有内容的租户策略。
RAG_RERANKER_ENABLED=false
RAG_RERANKER_PROVIDER=cross_encoder   # cross_encoder（本地 sentence-transformers）| http（本地 TEI/Xinference）
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_BASE_URL=                # 仅 provider=http 时需要，例如 http://localhost:8080
RAG_RERANKER_CANDIDATE_K=20           # 送进 cross-encoder 的粗召回条数，需 >= RAG_TOP_K
RAG_RERANKER_TIMEOUT_MS=3000          # 超时即永久降级为旧顺序（本进程内不再重试）
RAG_RERANKER_MIN_SCORE=0.0            # 归一化 0..1 相关性下限；0.0 表示不过滤

# ############ Writer 写后结构化提取实验 ############
# off: 零调用、零记录；shadow: 正文提交后额外执行一次typed extraction，仅记录实验结果
WRITER_POST_WRITE_EXTRACTION_MODE=off

# ############ Writer 风格控制与写后漂移评测 ############
# legacy: 保留旧风格行为调用/模板示例；shadow: 编译新 Policy 但不注入正文 Prompt；
# policy: 注入精简 Realization Policy。按计划默认 shadow，完成 A/B 盲审后再晋级。
WRITER_STYLE_CONTROL_MODE=shadow
# 确定性写后评测：记录目标偏差、跨小节漂移和文本证据；不会自动重写正文。
WRITER_STYLE_EVALUATION=true
# 基础去 AI 味表达 Kernel：off 默认不生效；shadow 只记录；canary 注入 Writer 软写作指引。
# 不评分、不重写、不改变事件合同，也不自动接入商业模板或 Reality 模块。
WRITER_ANTI_AI_EXPRESSION_MODE=off
# 商业网文三层 Harness。shadow 只记录编译结果；canary 才注入 Writer Prompt。
WRITER_COMMERCIAL_HARNESS_MODE=shadow
# 通用叙事可信度底线。shadow 只记录；canary 才注入，且先于类型和风格。
WRITER_NARRATIVE_INTEGRITY_MODE=shadow
# 世界因果是 Integrity 子契约；必须显式选择预设，系统不会从正文猜类型。
WRITER_WORLD_PRESSURE_MODE=shadow
WRITER_WORLD_PRESSURE_PRESET=none
WRITER_NARRATIVE_REALITY_CHECKS=true
# Compact World Runtime prompt projection. Production default remains off.
# shadow compiles/observes without injection; canary requires an exact task ID.
WRITER_WORLD_RUNTIME_MODE=off
WRITER_WORLD_RUNTIME_CANARY_TASK_IDS=

# Handover extractor contract. v1 preserves current production behavior.
WRITER_HANDOVER_CONTRACT_VERSION=v1
